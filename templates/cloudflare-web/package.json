{
  "name": "buddy-app",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node setup.mjs",
    "prerequisites": "node scripts/check-prerequisites.mjs",
    "dev": "vite",
    "dev:pages": "vite build && wrangler pages dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply buddy-app-db --local",
    "db:seed:local": "wrangler d1 execute buddy-app-db --local --file=seeds/seed.sql",
    "validate": "npm run typecheck && npm run build && npm run test && node --test scripts/scan-personal-data.test.mjs scripts/check-prerequisites.test.mjs scripts/scan-semgrep.test.mjs",
    "scan": "node scripts/scan-personal-data.mjs && node scripts/scan-semgrep.mjs --config .semgrep --error --metrics off --exclude node_modules --exclude dist --exclude .wrangler ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
